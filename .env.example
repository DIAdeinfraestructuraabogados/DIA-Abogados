# Motor de base de datos. Por defecto usa SQLite local (sin instalar nada).
# Para producción: DATABASE_URL=postgresql://usuario:clave@host:5432/dia_abogados
DATABASE_URL=sqlite:///./app/storage/casos.db

# Clave de cifrado en reposo (ver app/crypto.py) para nombre, cédula,
# correo, celular y las fotos de identidad. Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se deja vacía, se genera y guarda una automáticamente en
# app/storage/.field_key SOLO para desarrollo local — en Render hay que
# definir esta variable de verdad (el disco no es persistente entre
# despliegues, así que sin esto los datos ya cifrados quedan ilegibles
# después de cada redeploy).
FIELD_ENCRYPTION_KEY=

# Modo simulado para OTP/WhatsApp/correo (no requiere credenciales).
# Poner en "false" solo cuando haya integraciones reales configuradas abajo.
NOTIFY_MOCK=true

# Modo simulado del envío del derecho de petición (correo del abogado).
SMTP_ABOGADO_MOCK=true

# --- WhatsApp real (Meta Cloud API) — solo si NOTIFY_MOCK=false ---
# Ver README.md, sección "Probar envíos reales", para cómo conseguirlos.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# --- Correo real (Resend, por API HTTPS) — solo si NOTIFY_MOCK=false o
# SMTP_ABOGADO_MOCK=false. Se usa Resend en vez de SMTP porque hostings
# como Render bloquean el SMTP saliente tradicional. Ver README.md, sección
# "Probar envíos reales", para cómo conseguirlos. RESEND_FROM_EMAIL puede
# dejarse vacío para usar el remitente de prueba "onboarding@resend.dev"
# (solo permite enviar a la cuenta con la que te registraste en Resend). ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Correo real, alternativa por SMTP (Gmail con contraseña de
# aplicación) — solo sirve en local; Render y hostings similares bloquean
# este tráfico saliente. No se usa si SendGrid ya está configurado arriba. ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Datos de la campaña / caso (ver app/config.py para los valores por defecto)
DESCRIPCION_CASO=
APODERADO_NOMBRE=
APODERADO_TP=
APODERADO_EMAIL_RNA=
APODERADO_DOCUMENTO=
CLAUSULA_HONORARIOS=
CIUDAD_CASO=
